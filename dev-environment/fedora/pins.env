# Pinned artefacts for the Fedora 44 dev image (WP-PRD-10.T1). Source of truth
# for build.sh; the Containerfile also verifies everything it is given.
#
#   FEDORA_IMAGE     the base image, pinned by manifest digest (not a tag)
#   RUSTUP_INIT_*    the rustup installer for the pinned Rust toolchain
#   DOTNET_SDK_*     the .NET SDK tarball, taken at the version in
#                    clients/avalonia/global.json (the URL is derived from it)
#   PYTHON_PKG       the Fedora package that provides Python 3.12
#   POSTGRES_VERSION the PostgreSQL major version start-postgres.sh expects
#
# Refresh by downloading the artefact, recomputing the hash, and pasting it
# here and in the Containerfile defaults. Never paste a hash you did not
# compute from the publisher's own bytes.

FEDORA_IMAGE=registry.fedoraproject.org/fedora@sha256:e9a013b99bbbe0b21c42e029ec7811ef5c8ea5fbdaf78575f7cd482cf4d21b90

RUSTUP_INIT_URL=https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init
RUSTUP_INIT_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71

DOTNET_SDK_BASE=https://builds.dotnet.microsoft.com/dotnet
DOTNET_SDK_SHA512=51c8b999af9e8dd9998c9edc5944e19a90788862068acd38694e098889054ce8c23d4f0c5cccfa16bf187d044562359e5ee69a9f8ad0bbe913ba90311fbce25b

PYTHON_PKG=python3.12
POSTGRES_VERSION=18
