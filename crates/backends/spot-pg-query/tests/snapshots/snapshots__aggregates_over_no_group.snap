---
source: crates/backends/spot-pg-query/tests/snapshots.rs
expression: render(& ok(& q))
---
SELECT COUNT(*) AS "n", COUNT("p"."note") AS "n_note", COUNT(DISTINCT "p"."name" COLLATE "C") AS "n_names", COUNT(DISTINCT "p"."visits") AS "n_visits", CAST(SUM("p"."visits") AS int8) AS "visits_sum", SUM("p"."credit_limit") AS "limit_sum", SUM(DISTINCT "p"."credit_limit") AS "limit_sum_distinct", MIN("p"."name" COLLATE "spot_en") AS "first_name", MAX("p"."name" COLLATE "spot_en") AS "last_name", MIN("p"."since") AS "first_since", MAX("p"."seen_at") AS "last_seen", MIN("p"."opens_at") AS "first_open", bool_and("p"."active") AS "all_active", bool_or("p"."active") AS "any_active", (array_agg("p"."id" ORDER BY "p"."id" ASC) FILTER (WHERE "p"."id" IS NOT NULL))[1] AS "min_id", (array_agg("p"."logo" ORDER BY "p"."logo" DESC) FILTER (WHERE "p"."logo" IS NOT NULL))[1] AS "max_logo" FROM "party" AS "p" OFFSET $1
$1 = Int8(0)
columns = ["n", "n_note", "n_names", "n_visits", "visits_sum", "limit_sum", "limit_sum_distinct", "first_name", "last_name", "first_since", "last_seen", "first_open", "all_active", "any_active", "min_id", "max_logo"]
decode = [Int, Int, Int, Int, Int, Decimal { scale: Some(2) }, Decimal { scale: Some(2) }, Text, Text, Date, DateTime, Time, Bool, Bool, Id, Bytes]
path = Transactional
