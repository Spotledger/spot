---
source: crates/backends/spot-pg-query/tests/constructs.rs
expression: "render(&\nok(& stay_with(RangeTest::Overlaps { start: a.clone(), end: b.clone() }), &\nrange_cat()))"
---
SELECT "x"."unit" AS "unit" FROM "stay" AS "x" WHERE ("x"."during" && daterange($1, $2, '[)')) ORDER BY "x"."id" ASC OFFSET $3
$1 = Date(2026-11-02)
$2 = Date(2026-11-05)
$3 = Int8(0)
columns = ["unit"]
decode = [Text]
