---
source: crates/backends/spot-pg-query/tests/snapshots.rs
expression: render(&c)
---
SELECT "p"."name" AS "name" FROM "party" AS "p" WHERE (strpos("p"."name" COLLATE "C", $1 COLLATE "C") > 0) ORDER BY "p"."id" ASC OFFSET $2
$1 = Text("50%_\\off")
$2 = Int8(0)
columns = ["name"]
decode = [Text]
path = Transactional
