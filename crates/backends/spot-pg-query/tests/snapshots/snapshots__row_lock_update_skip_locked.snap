source: crates/backends/spot-pg-query/tests/snapshots.rs
expression: render(&ok(&q))
---
SELECT "i"."number" AS "number", "p"."name" AS "party_name" FROM "invoice" AS "i" INNER JOIN "party" AS "p" ON ("i"."party" = "p"."id") WHERE (("p"."id" IS NULL) OR ("p"."name" COLLATE "C" = $1 COLLATE "C")) ORDER BY "p"."name" COLLATE "spot_en" ASC NULLS LAST, "p"."name" COLLATE "C" ASC NULLS LAST, "i"."id" ASC LIMIT $2 OFFSET $3 FOR UPDATE OF "i" SKIP LOCKED
$1 = Text("x")
$2 = Int8(1)
$3 = Int8(0)
columns = ["number", "party_name"]
decode = [Text, Text]
path = Report
