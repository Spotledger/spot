---
source: crates/backends/spot-pg-query/tests/snapshots.rs
expression: "render(& ok(& invoice_join(JoinKind::Inner)))"
---
SELECT "i"."number" AS "number", "p"."name" AS "party_name" FROM "invoice" AS "i" INNER JOIN "party" AS "p" ON ("i"."party" = "p"."id") WHERE (("p"."id" IS NULL) OR ("p"."name" COLLATE "C" = $1 COLLATE "C")) ORDER BY "p"."name" COLLATE "spot_en" ASC NULLS LAST, "p"."name" COLLATE "C" ASC NULLS LAST, "i"."id" ASC OFFSET $2
$1 = Text("x")
$2 = Int8(0)
columns = ["number", "party_name"]
decode = [Text, Text]
path = Report
