/// Generated by spot-dts from the site's effective DocType metadata. Do not edit; regenerate.
/* eslint-disable */
/**
 * The standard fields every document has, alongside its own.
 */
interface DocumentBase {
  /** The record id (a UUIDv7). */
  id?: string;
  /** The version; absent before the first save. */
  version?: number;
  /** The lifecycle state of a posted DocType ("draft" | "posted" | "cancelled"). */
  _state?: string;
}

/** cycle_a. */
export interface CycleA extends DocumentBase {
  /** other */
  other?: string;
}

/** cycle_b. */
export interface CycleB extends DocumentBase {
  /** back */
  back?: string;
}

/** The document host functions a script may call. */
declare namespace spot {
  /** Every DocType the site defines (parents only). */
  type DocTypeName =
    | "CycleA"
    | "CycleB";
  /** The interface of one DocType, selected by its name. */
  type DocOf<N extends DocTypeName> = {
    "CycleA": CycleA;
    "CycleB": CycleB;
  }[N];
  /** Loads a document as its interface, or null when there is none. */
  function getDoc<N extends DocTypeName>(doctype: N, id: string): DocOf<N> | null;
}
