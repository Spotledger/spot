impl<'a> InvoiceLineRow<'a> {
    /// The row's record id.
    #[must_use]
    pub fn id(&self) -> RecordId {
        self.0.id
    }
    /// Item (`item`).
    pub fn item(&self) -> AppResult<Option<&str>> {
        match row_value_of(self.0, "item") {
            Value::Null => Ok(None),
            Value::Text(t) => Ok(Some(t.as_str())),
            _ => Err(wrong_type("item")),
        }
    }
    /// Quantity (`qty`).
    pub fn qty(&self) -> AppResult<Option<Decimal>> {
        match row_value_of(self.0, "qty") {
            Value::Null => Ok(None),
            Value::Decimal(d) => Ok(Some(*d)),
            _ => Err(wrong_type("qty")),
        }
    }
    /// Amount (`amount`).
    pub fn amount(&self) -> AppResult<Option<Decimal>> {
        match row_value_of(self.0, "amount") {
            Value::Null => Ok(None),
            Value::Decimal(d) => Ok(Some(*d)),
            _ => Err(wrong_type("amount")),
        }
    }
}
