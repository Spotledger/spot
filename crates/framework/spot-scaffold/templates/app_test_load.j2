//! Loads {{ title }}'s DocTypes through `spot-meta`, the way the platform does.
//!
//! Generated by `spot-scaffold` (WP-DX-01.T1). Adjust the `spot-meta` path to your
//! workspace before running it.
#![allow(missing_docs, clippy::unwrap_used, clippy::expect_used)]

#[test]
fn doctypes_load() {
    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("app/doctypes");
    let definitions = spot_meta::load_dir(&dir).expect("the DocTypes load");
    let meta = spot_meta::Registry::build(definitions, &spot_meta::Customisations::new())
        .expect("the DocTypes build");
    assert!(
        meta.definition("{{ doctype_name }}").is_some(),
        "the {{ doctype_name }} DocType is in the effective metadata"
    );
}
