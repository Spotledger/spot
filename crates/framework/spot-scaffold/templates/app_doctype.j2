# {{ label }} ({{ name }}) — generated by spot-scaffold (WP-DX-01.T1).
#
# A DocType definition (spot-meta's authoring TOML). `spot-pack check` loads it through
# spot-meta and reports every schema fault.
name = "{{ name }}"
label = "{{ label_toml }}"
app = "{{ app }}"
module = "{{ module }}"
title_field = "title"
naming = "{{ prefix }}-.YYYY.-.#####"

[[fields]]
name = "title"
label = "Title"
type = "text"
max_chars = 140
required = true
in_list_view = true

[[fields]]
name = "status"
label = "Status"
type = "select"
options = "Draft\nOpen\nClosed"
default = "Draft"
in_list_view = true
in_standard_filter = true
{% for f in fields %}
[[fields]]
name = "{{ f.name }}"
label = "{{ f.label }}"
type = "{{ f.type }}"
{{ f.body }}
{% endfor %}
