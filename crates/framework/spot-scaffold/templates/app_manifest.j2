# {{ title }} — the app manifest (ADR-17). Generated by spot-scaffold (WP-DX-01.T1).
#
# Everything this app attaches to the platform is declared here. `spot-pack check app`
# validates it; the installer reads it. Every table except `[app]` is optional.
[app]
name = "{{ name }}"
version = "{{ version }}"
title = "{{ title_toml }}"
{% if with_controller %}
# The {{ doctype_label }} controller step, provided by the native controller in `src/`
# (`native:{{ name }}`).
[[events]]
doctype = "{{ doctype_label }}"
event = "validate_save"
step = "{{ name }}:validate_{{ doctype_name }}"
{% endif %}
{% if with_script %}
# The {{ script_name }} route, served by `scripts/{{ script_name }}.ts`.
[[routes]]
path = "/{{ script_name }}"
step = "{{ name }}:{{ script_name }}"
{% endif %}
