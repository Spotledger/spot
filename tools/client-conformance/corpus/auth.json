{
 "topic": "Sign-in, expired session, re-auth and sign-out",
 "cases": [
  {
   "name": "sign in",
   "description": "The login request carries no Authorization header; the token is held, never emitted.",
   "steps": [
    {
     "in": {
      "type": "request",
      "op": "sign_in",
      "req_id": 1,
      "user": "a@x.test",
      "password": "pw"
     },
     "out": [
      {
       "type": "send_http",
       "id": 1,
       "request": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Content-Type",
          "application/json"
         ]
        ],
        "body": "{\"password\":\"pw\",\"user\":\"a@x.test\"}"
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 1,
      "reply": {
       "status": 200,
       "headers": [],
       "body": "{\"data\":{\"token\":\"tok-1\",\"expires_at\":\"2026-11-06T08:00:00Z\",\"user\":{\"id\":\"u1\",\"email\":\"a@x.test\",\"full_name\":\"A\"}}}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "signed_in",
       "req_id": 1,
       "user_id": "u1",
       "expires_at": "2026-11-06T08:00:00Z"
      }
     ]
    }
   ]
  },
  {
   "name": "two-factor needed",
   "description": "",
   "steps": [
    {
