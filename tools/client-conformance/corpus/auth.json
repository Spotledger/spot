        ],
        "body": "{\"password\":\"pw\",\"user\":\"a@x.test\"}"
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 1,
      "reply": {
       "status": 401,
       "headers": [],
       "body": "{\"error\":{\"code\":\"auth.totp_required\",\"message\":\"m\",\"retryable\":false,\"request_id\":\"r1\"}}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "failed",
       "req_id": 1,
       "status": 401,
       "problem": {
        "code": "auth.totp_required",
        "message": "m",
        "retryable": false,
        "request_id": "r1"
       }
      }
     ]
    },
    {
     "in": {
      "type": "request",
      "op": "sign_in",
      "req_id": 2,
      "user": "a@x.test",
      "password": "pw",
      "totp": "123456"
     },
     "out": [
      {
       "type": "send_http",
       "id": 2,
       "request": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Content-Type",
          "application/json"
         ]
        ],
        "body": "{\"password\":\"pw\",\"totp\":\"123456\",\"user\":\"a@x.test\"}"
       }
      }
     ]
    }
   ]
  },
  {
   "name": "call before sign-in is refused locally",
   "description": "",
   "steps": [
    {
     "in": {
      "type": "request",
      "op": "resource_get",
      "req_id": 1,
      "doctype": "Invoice",
      "id": "INV-1"
     },
     "out": [
      {
       "type": "emit",
       "event": "failed",
       "req_id": 1,
       "status": 0,
       "problem": {
        "code": "auth.not_signed_in",
        "message": "Sign in first.",
        "retryable": false
       }
      }
     ]
    }
   ]
  },
