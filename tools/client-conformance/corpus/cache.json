{
 "topic": "Version-checked reads",
 "cases": [
  {
   "name": "second read is conditional and a 304 serves the cached copy",
   "description": "",
   "steps": [
    {
     "in": {
      "type": "request",
      "op": "sign_in",
      "req_id": 1,
      "user": "a@x.test",
      "password": "pw"
     },
     "out": [
      {
       "type": "send_http",
       "id": 1,
       "request": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Content-Type",
          "application/json"
         ]
        ],
        "body": "{\"password\":\"pw\",\"user\":\"a@x.test\"}"
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 1,
      "reply": {
       "status": 200,
       "headers": [],
       "body": "{\"data\":{\"token\":\"tok-1\",\"expires_at\":\"2026-11-06T08:00:00Z\",\"user\":{\"id\":\"u1\",\"email\":\"a@x.test\",\"full_name\":\"A\"}}}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "signed_in",
       "req_id": 1,
       "user_id": "u1",
       "expires_at": "2026-11-06T08:00:00Z"
      }
     ]
    },
    {
     "in": {
      "type": "request",
      "op": "resource_get",
      "req_id": 2,
      "doctype": "Invoice",
      "id": "INV-1"
     },
     "out": [
      {
       "type": "send_http",
       "id": 2,
       "request": {
        "method": "GET",
        "path": "/api/v1/resource/Invoice/INV-1",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Authorization",
          "Bearer tok-1"
         ]
        ]
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 2,
      "reply": {
       "status": 200,
       "headers": [
        [
         "ETag",
         "\"3\""
        ]
       ],
       "body": "{\"data\":{\"id\":\"INV-1\",\"version\":3}}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "resource",
       "req_id": 2,
       "body": "{\"data\":{\"id\":\"INV-1\",\"version\":3}}",
       "from_cache": false
      }
     ]
    },
    {
     "in": {
      "type": "request",
      "op": "resource_get",
      "req_id": 3,
      "doctype": "Invoice",
      "id": "INV-1"
     },
     "out": [
      {
       "type": "send_http",
       "id": 3,
       "request": {
        "method": "GET",
        "path": "/api/v1/resource/Invoice/INV-1",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Authorization",
          "Bearer tok-1"
         ],
         [
          "If-None-Match",
          "\"3\""
         ]
        ]
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 3,
      "reply": {
       "status": 304,
       "headers": [],
       "body": ""
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "resource",
       "req_id": 3,
       "body": "{\"data\":{\"id\":\"INV-1\",\"version\":3}}",
       "from_cache": true
      }
     ]
    }
   ]
  },
  {
   "name": "a list is cached by query and carries its ETag",
   "description": "",
   "steps": [
    {
     "in": {
      "type": "request",
      "op": "sign_in",
      "req_id": 1,
      "user": "a@x.test",
      "password": "pw"
     },
     "out": [
      {
       "type": "send_http",
       "id": 1,
       "request": {
        "method": "POST",
        "path": "/api/v1/auth/login",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Content-Type",
          "application/json"
         ]
        ],
        "body": "{\"password\":\"pw\",\"user\":\"a@x.test\"}"
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 1,
      "reply": {
       "status": 200,
       "headers": [],
       "body": "{\"data\":{\"token\":\"tok-1\",\"expires_at\":\"2026-11-06T08:00:00Z\",\"user\":{\"id\":\"u1\",\"email\":\"a@x.test\",\"full_name\":\"A\"}}}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "signed_in",
       "req_id": 1,
       "user_id": "u1",
       "expires_at": "2026-11-06T08:00:00Z"
      }
     ]
    },
    {
     "in": {
      "type": "request",
      "op": "resource_list",
      "req_id": 2,
      "doctype": "Sales Invoice",
      "query": "limit=10"
     },
     "out": [
      {
       "type": "send_http",
       "id": 2,
       "request": {
        "method": "GET",
        "path": "/api/v1/resource/Sales%20Invoice?limit=10",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Authorization",
          "Bearer tok-1"
         ]
        ]
       }
      }
     ]
    },
    {
     "in": {
      "type": "transport_reply",
      "id": 2,
      "reply": {
       "status": 200,
       "headers": [
        [
         "ETag",
         "\"7\""
        ]
       ],
       "body": "{\"data\":[]}"
      }
     },
     "out": [
      {
       "type": "emit",
       "event": "resource",
       "req_id": 2,
       "body": "{\"data\":[]}",
       "from_cache": false
      }
     ]
    },
    {
     "in": {
      "type": "request",
      "op": "resource_list",
      "req_id": 3,
      "doctype": "Sales Invoice",
      "query": "limit=10"
     },
     "out": [
      {
       "type": "send_http",
       "id": 3,
       "request": {
        "method": "GET",
        "path": "/api/v1/resource/Sales%20Invoice?limit=10",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Authorization",
          "Bearer tok-1"
         ],
         [
          "If-None-Match",
          "\"7\""
         ]
        ]
       }
      }
     ]
    }
   ]
  },
  {
