   "description": "A field reveal carries an audited reason and is never replayed, so it is not stored.",
   "name": "reveal path",
   "start": {
    "out": [
     {
      "id": 1,
      "key": "queue",
      "type": "storage_read"
     }
    ],
    "site": "s1"
   },
   "steps": [
    {
     "in": {
      "id": 1,
      "type": "storage_reply",
      "value": null
     },
     "out": []
    },
    {
     "in": {
      "op": "sign_in",
      "password": "pw",
      "req_id": 1,
      "type": "request",
      "user": "u1@x.test"
     },
     "out": [
      {
       "id": 1,
       "request": {
        "body": "{\"password\":\"pw\",\"user\":\"u1@x.test\"}",
        "headers": [
         [
          "Accept",
          "application/json"
         ],
         [
          "Content-Type",
          "application/json"
         ]
        ],
        "method": "POST",
        "path": "/api/v1/auth/login"
       },
       "type": "send_http"
      }
     ]
    },
    {
     "in": {
      "id": 1,
      "reply": {
       "body": "{\"data\":{\"token\":\"tok-1\",\"expires_at\":\"2026-11-06T08:00:00Z\",\"user\":{\"id\":\"u1\"}}}",
       "headers": [],
       "status": 200
      },
      "type": "transport_reply"
     },
     "out": [
      {
       "event": "signed_in",
       "expires_at": "2026-11-06T08:00:00Z",
