{
  "contract_version": "0.1.0",
  "requires_shell": "0.1.0",
  "app": "sample",
  "actions": [
    {
      "id": "sample.start_work",
      "origin": "app:sample",
      "label": "Start work",
      "icon": "play",
      "slot": "doc.toolbar",
      "doctype": "task",
      "order": 10,
      "visible_if": "doc.status == 'Open'",
      "enabled_if": "not is_empty(doc.assignee)",
      "permission": "task:write",
      "confirm": "Start work on this task?",
      "call": {
        "doctype": "task",
        "method": "start_work",
        "args": {
          "task": "doc.name"
        },
        "then": "refresh"
      }
    },
    {
      "id": "sample.open_time",
      "origin": "app:sample",
      "label": "Time entries",
      "icon": "time",
      "slot": "doc.toolbar",
      "doctype": "task",
      "order": 20,
      "permission": "time_entry:read",
      "open": {
        "destination": "sample.time_entries",
        "filters": {
          "task": "doc.name"
        }
      }
    }
  ],
  "panels": [
    {
      "id": "sample.task_overview",
      "origin": "app:sample",
      "label": "Overview",
      "slot": "doc.sidepanel",
      "doctype": "project",
      "order": 0,
      "permission": "project:read",
      "blocks": [
        {
          "type": "field_list",
          "fields": [
            "status",
            "owner",
            "budget"
          ]
        },
        {
          "type": "stat",
          "query": "sample.open_tasks",
          "label": "Open tasks",
          "format": "int"
        },
        {
          "type": "table",
          "query": "sample.recent_time_entries",
          "columns": [
            {
              "field": "work_date"
            },
            {
              "field": "person"
            },
            {
              "field": "hours",
              "label": "Hours"
            }
          ],
          "max_rows": 5,
          "open": true
        },
        {
          "type": "text",
          "markdown": "Open the [task list](dest:sample.tasks) to see more."
        }
      ]
    }
  ],
  "components": [
    {
      "id": "sample.project_health",
      "origin": "app:sample",
      "props": [
        {
          "name": "open",
          "type": "int",
          "required": true
        },
        {
          "name": "total",
          "type": "int",
          "required": true
        }
      ],
      "slots": [
        "footer"
      ],
      "body": {
        "node": "column",
        "title": "Project health",
        "children": [
          {
            "node": "control",
            "control": "heading",
            "text": "Project health"
          },
          {
            "node": "when",
            "test": "doc.total > 0",
            "then": {
              "node": "control",
              "control": "progress",
              "value": "doc.total - doc.open"
            }
          },
          {
            "node": "control",
            "control": "number",
            "value": "doc.open"
          },
          {
            "node": "slot",
            "name": "footer"
          }
        ]
      }
    }
  ],
  "tiles": [
    {
      "id": "sample.health_tile",
      "origin": "app:sample",
      "label": "Project health",
      "icon": "chart",
      "slot": "home.tiles",
      "order": 5,
      "component": "sample.project_health",
      "props": {
        "open": {
          "query": "sample.open_tasks"
        },
        "total": {
          "query": "sample.task_count"
        }
      },
      "open": {
        "destination": "sample.projects"
      }
    }
  ]
}
