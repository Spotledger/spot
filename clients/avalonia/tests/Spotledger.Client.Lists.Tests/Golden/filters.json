[
 {
  "name": "text contains",
  "field": "title",
  "op": "Contains",
  "values": [
   "ab"
  ],
  "expected": {
   "field": "title",
   "op": "contains",
   "value": "ab",
   "case_insensitive": true
  }
 },
 {
  "name": "text starts",
  "field": "title",
  "op": "StartsWith",
  "values": [
   "ab"
  ],
