   "field": "title",
   "op": "prefix",
   "value": "ab",
   "case_insensitive": true
  }
 },
 {
  "name": "text equals",
  "field": "title",
  "op": "Equals",
  "values": [
   "ab"
  ],
  "expected": {
   "field": "title",
   "op": "eq",
   "value": "ab"
  }
 },
 {
  "name": "text not equals",
  "field": "title",
  "op": "NotEquals",
  "values": [
   "ab"
  ],
  "expected": {
   "field": "title",
   "op": "ne",
   "value": "ab"
  }
 },
 {
  "name": "text empty",
  "field": "title",
  "op": "IsEmpty",
  "values": [],
  "expected": {
   "field": "title",
   "op": "is_null"
  }
 },
 {
  "name": "text not empty",
  "field": "title",
  "op": "IsNotEmpty",
  "values": [],
  "expected": {
   "field": "title",
   "op": "is_not_null"
  }
 },
 {
  "name": "text literal percent stays literal",
  "field": "title",
  "op": "Contains",
  "values": [
   "100%_x"
  ],
  "expected": {
   "field": "title",
   "op": "contains",
   "value": "100%_x",
   "case_insensitive": true
  }
 },
 {
  "name": "text injection stays a value",
  "field": "title",
  "op": "Equals",
  "values": [
   "x' OR 1=1 --"
  ],
  "expected": {
   "field": "title",
   "op": "eq",
   "value": "x' OR 1=1 --"
  }
 },
