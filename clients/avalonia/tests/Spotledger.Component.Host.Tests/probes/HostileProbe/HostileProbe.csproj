<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HostileProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- A deliberately impolite component package: it reaches for the application's own code.
         The test project builds it but does not reference it, so the loader is the only way in. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Spotledger.Client.Core/Spotledger.Client.Core.csproj" />
  </ItemGroup>
</Project>
