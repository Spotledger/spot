<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12 brings xunit v3; do not also reference xunit 2. -->
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- The screenshot set needs a real rasterizer (UseHeadlessDrawing=false +
         CaptureRenderedFrame): Avalonia.Skia arrives through Avalonia.Desktop, the
         same platform package the Desktop host runs on. No new version pins. -->
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Spotledger.Client.Grid/Spotledger.Client.Grid.csproj" />
    <ProjectReference Include="../../src/Spotledger.Client.Controls/Spotledger.Client.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="perf-budgets.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>