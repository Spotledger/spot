<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-UI-02.T5: notifications and document staleness over the realtime client. The core
       (notice parsing, the feed, the toast queue, the staleness watcher) has no Avalonia type; the
       views are in the same project, as in Lists and Reports. Time is an injected TimeProvider. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Spotledger.Client.Realtime/Spotledger.Client.Realtime.csproj" />
    <ProjectReference Include="../Spotledger.Client.Shell/Spotledger.Client.Shell.csproj" />
    <ProjectReference Include="../Spotledger.Client.Theme/Spotledger.Client.Theme.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spotledger.Client.Notifications.Tests" />
  </ItemGroup>
</Project>
