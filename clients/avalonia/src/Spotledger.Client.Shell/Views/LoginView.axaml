<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spotledger.Client.Shell"
             x:Class="Spotledger.Client.Shell.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid MaxWidth="420" Margin="24" VerticalAlignment="Center">
    <StackPanel Spacing="12">
      <TextBlock Text="Sign in"
                 FontSize="{DynamicResource Font.Size.Title}"
                 FontWeight="{DynamicResource Font.Weight.Semibold}"
                 Foreground="{DynamicResource Color.Text.Primary}" />
      <TextBlock Text="{Binding ServerDisplay}"
                 FontSize="{DynamicResource Font.Size.Caption}"
                 Foreground="{DynamicResource Color.Text.Secondary}" />
      <Panel>
        <TextBox Text="{Binding User, Mode=TwoWay}" PlaceholderText="User or e-mail" />
        <TextBlock Text="{Binding UserFieldMessage}"
                   IsVisible="{Binding HasUserFieldMessage}"
                   Foreground="{DynamicResource Color.Semantic.Danger}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-16" />
      </Panel>
      <Panel>
        <TextBox Text="{Binding Password, Mode=TwoWay}"
                 PasswordChar="●"
                 PlaceholderText="Password" />
        <TextBlock Text="{Binding PasswordFieldMessage}"
                   IsVisible="{Binding HasPasswordFieldMessage}"
                   Foreground="{DynamicResource Color.Semantic.Danger}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-16" />
      </Panel>
      <CheckBox Name="RememberMeBox" Content="Remember me on this computer"
                IsChecked="{Binding RememberMe, Mode=TwoWay}"
                AutomationProperties.Name="Remember me on this computer" />
      <TextBlock Name="RememberMeNoticeText"
                 Text="{Binding RememberMeNotice}"
                 FontSize="{DynamicResource Font.Size.Caption}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding RememberMeNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBox Text="{Binding TotpCode, Mode=TwoWay}"
               PlaceholderText="One-time code"
               IsVisible="{Binding ShowTotpField}" />
      <TextBlock Text="{Binding TotpFieldMessage}"
                 IsVisible="{Binding HasTotpFieldMessage}"
                 Foreground="{DynamicResource Color.Semantic.Danger}"
                 FontSize="{DynamicResource Font.Size.Caption}" />
      <TextBlock Text="{Binding FormMessage}"
                 IsVisible="{Binding HasFormMessage}"
                 Foreground="{DynamicResource Color.Semantic.Danger}"
                 FontSize="{DynamicResource Font.Size.Body}"
                 TextWrapping="Wrap" />
      <Button Content="Sign in"
              Command="{Binding SignInCommand}"
              Classes="accent"
              HorizontalAlignment="Stretch" />
      <Button Content="Back to server picker"
              Command="{Binding BackCommand}"
              Classes="link"
              HorizontalAlignment="Left" />
    </StackPanel>
  </Grid>
</UserControl>