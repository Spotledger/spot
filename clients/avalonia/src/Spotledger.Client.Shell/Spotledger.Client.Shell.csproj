<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-UI-02.T1/T2: the Avalonia shell — server picker, login, and the real chrome:
       command model, native menu bar, tabs, sidebar, Ctrl+K launcher, status bar.
       Plain MVVM (INotifyPropertyChanged + small commands); styled only with
       Spotledger.Client.Theme tokens and the design-system controls. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Keymaps/*.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spotledger.Client.Shell.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Spotledger.Client.Api/Spotledger.Client.Api.csproj" />
    <ProjectReference Include="../Spotledger.Client.Controls/Spotledger.Client.Controls.csproj" />
    <ProjectReference Include="../Spotledger.Client.Theme/Spotledger.Client.Theme.csproj" />
  </ItemGroup>
</Project>
