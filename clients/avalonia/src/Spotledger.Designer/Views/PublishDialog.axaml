<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spotledger.Client.Designer.Views.PublishDialog">
  <!-- The publish dialog: the server's plan summary, the blocking issues, an explicit
       confirmation, and the refusal when the server decides this designer may not publish. -->
  <Border Background="#88000000" IsVisible="{Binding Publish.IsOpen}">
    <Border MaxWidth="560"
            MaxHeight="520"
            Margin="24"
            Padding="16"
            CornerRadius="6"
            Background="{DynamicResource Color.Surface.Raised}"
            BorderBrush="{DynamicResource Color.Border.Strong}"
            BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Publish this design"
                     FontSize="{DynamicResource Font.Size.Heading}"
                     Foreground="{DynamicResource Color.Text.Primary}" />
          <TextBlock Text="{Binding Publish.SubjectText}" TextWrapping="Wrap" Foreground="{DynamicResource Color.Text.Secondary}" />
          <TextBlock Text="{Binding Publish.RiskText}" TextWrapping="Wrap" Foreground="{DynamicResource Color.Semantic.Warning}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10">
          <StackPanel Spacing="8">
            <TextBlock Text="What changes" FontWeight="SemiBold" Foreground="{DynamicResource Color.Text.Primary}" />
            <ItemsControl ItemsSource="{Binding Publish.Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource Font.Size.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Color.Text.Secondary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Must be fixed first" FontWeight="SemiBold" Foreground="{DynamicResource Color.Semantic.Danger}" />
            <ItemsControl ItemsSource="{Binding Publish.BlockingIssues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Message}" FontSize="{DynamicResource Font.Size.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Color.Semantic.Danger}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
          <CheckBox Content="I have read what this changes and I want to publish it."
                    IsChecked="{Binding Publish.IsConfirmed, Mode=TwoWay}" />
          <TextBlock Text="{Binding Publish.BlockedReason}"
                     FontSize="{DynamicResource Font.Size.Caption}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Color.Text.Secondary}" />
          <TextBlock Text="{Binding Publish.Result}"
                     FontSize="{DynamicResource Font.Size.Caption}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource Color.Semantic.Danger}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Publish" Command="{Binding Publish.ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</UserControl>
