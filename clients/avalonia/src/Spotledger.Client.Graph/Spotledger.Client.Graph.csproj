<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP-GRA-06.T1: the Avalonia graph views. Presentation only: the hierarchy model
       navigates a paged IHierarchySource, the lineage view lays out a GraphSnapshot
       handed over by the typed graph query client, and every edit goes back through a
       server-checked seam. No Api/Metadata knowledge here; styling comes from Theme
       tokens, exactly like Spotledger.Client.Grid. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="../Spotledger.Client.Controls/Spotledger.Client.Controls.csproj" />
    <ProjectReference Include="../Spotledger.Client.Theme/Spotledger.Client.Theme.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spotledger.Client.Graph.Tests" />
  </ItemGroup>
</Project>
