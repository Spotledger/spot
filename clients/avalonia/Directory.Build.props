<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Pinned: `latest` follows the SDK feature band (rollForward latestFeature), so a newer hosted SDK adds analyzers (CA2026, CA2027, CA1830) that turn into errors under TreatWarningsAsErrors. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <!-- The hosted runner's SDK feature band still reports these rules (CA1830 on the v0.1.9 run, CA2026 and CA2027 on 0.1.7) as errors under TreatWarningsAsErrors although the analysis level is pinned. They stay visible as warnings; the code sites are fixed as they are touched. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1830;CA2026;CA2027</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
