# Spotledger control plane runtime image. It packages a prebuilt release binary;
# there is no compiler stage. Build context: the directory holding
# `spot-control-plane` (the release binary), LICENSE and NOTICE.
#
#   podman build --build-arg VERSION=1.2.3 -t spot-control-plane:1.2.3 \
#       -f packaging/linux/control-plane/container/Containerfile <context>
#
# The final image is assembled from nothing: only the C library, libgcc and
# curl-minimal (the health probe) are installed into an empty root with dnf, so there is
# NO shell and no package manager in it. It runs as a non-root user and is meant
# to run with a read-only root filesystem:
#
#   podman run --read-only --cap-drop=all --security-opt=no-new-privileges \
#       -v /etc/spot-control-plane:/etc/spot-control-plane:ro \
#       -v spot-cp-state:/var/lib/spot-control-plane \
#       spot-control-plane:1.2.3 run --config /etc/spot-control-plane/control-plane.toml
#
# NO key, CA, certificate or password is baked in: they are mounted files.

ARG VERSION=0.0.0

FROM registry.fedoraproject.org/fedora:44 AS rootfs
RUN dnf -y --installroot=/rootfs --use-host-config --releasever=44 \
        --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        install glibc libgcc curl-minimal \
 && dnf -y --installroot=/rootfs --use-host-config clean all \
 && install -d -m 0755 /rootfs/etc /rootfs/usr/share/licenses/spot-control-plane \
 && install -d -o 10001 -g 10001 -m 0700 /rootfs/var/lib/spot-control-plane \
 && install -d -m 0755 /rootfs/etc/spot-control-plane \
 && printf 'spot-control-plane:x:10001:10001:Spotledger control plane:/var/lib/spot-control-plane:/sbin/nologin\n' > /rootfs/etc/passwd \
 && printf 'spot-control-plane:x:10001:\n' > /rootfs/etc/group \
 && rm -rf /rootfs/var/cache /rootfs/var/log/* /rootfs/usr/share/man /rootfs/usr/share/info

FROM scratch
ARG VERSION
LABEL org.opencontainers.image.title="spot-control-plane" \
      org.opencontainers.image.description="Spotledger control plane" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://spotledger.example/" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=rootfs /rootfs/ /
COPY spot-control-plane /usr/bin/spot-control-plane
COPY LICENSE NOTICE /usr/share/licenses/spot-control-plane/

VOLUME ["/var/lib/spot-control-plane"]
# Operator listener, host and agent listener.
EXPOSE 8443 8444
STOPSIGNAL SIGTERM

USER 10001:10001
WORKDIR /var/lib/spot-control-plane

# GET /cp/v1/live on the operator listener. The listener demands a client
# certificate from the operator CA, so the probe uses a dedicated one mounted
# read-only (see the control-plane deployment notes); liveness needs no
# allow-list entry. The exec form needs no shell.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["/usr/bin/curl", "--fail", "--silent", "--show-error", \
       "--cacert", "/etc/spot-control-plane/probe/server-ca.pem", \
       "--cert", "/etc/spot-control-plane/probe/client.pem", \
       "--key", "/etc/spot-control-plane/probe/client.key", \
       "https://127.0.0.1:8443/cp/v1/live"]

ENTRYPOINT ["/usr/bin/spot-control-plane"]
CMD ["run", "--config", "/etc/spot-control-plane/control-plane.toml"]
