%global debug_package %{nil}
%global _hardened_build 1

# The spec is a template: tools/packaging/build.py substitutes the version,
# release and changelog markers from the release arguments, then runs rpmbuild.
# It packages a prebuilt binary exactly as released; nothing is compiled here,
# so the same artefact is packaged on every host.
Name:           spot
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        Spotledger site host
License:        Apache-2.0
URL:            https://spotledger.example/
Source0:        spot
Source1:        spot.sysusers
Source2:        spot.tmpfiles
Source3:        spot.service
Source4:        spot.toml
Source5:        environment
Source6:        LICENSE
Source7:        README.install
Source8:        NOTICE

BuildArch:      @ARCH@
# systemd-rpm-macros provides the scriptlet helpers used by the pre, post and
# uninstall sections below: the install, uninstall and restart helpers plus the
# sysusers compat helper. The macro names are not spelled out here on purpose:
# rpm expands macro references inside a comment line, so a bare name would be
# expanded with no arguments and abort the build before anything is packaged.
BuildRequires:  systemd-rpm-macros
# The daemon is prebuilt; its ELF dependencies are generated by rpmbuild.
# Keep the explicit list minimal: only what the packaging itself needs.
Requires:       systemd
Requires(pre):  shadow-utils

%description
Spotledger is a single-binary site host on PostgreSQL. This package installs
the daemon, a hardened systemd unit, the sysusers/tmpfiles data and a safe
default configuration under /etc/spot. It does not start or enable the
service; an administrator provisions a site first and then starts it.

%prep
# Nothing to unpack: every source is a file supplied by the release build.

%build
# Nothing to compile: the binary is packaged as released.

%install
rm -rf %{buildroot}
install -d -m 0755 %{buildroot}%{_bindir}
install -m 0755 %{SOURCE0} %{buildroot}%{_bindir}/spot

install -d -m 0755 %{buildroot}%{_unitdir}
install -m 0644 %{SOURCE3} %{buildroot}%{_unitdir}/spot.service
install -d -m 0755 %{buildroot}%{_sysusersdir}
install -m 0644 %{SOURCE1} %{buildroot}%{_sysusersdir}/spot.conf
install -d -m 0755 %{buildroot}%{_tmpfilesdir}
install -m 0644 %{SOURCE2} %{buildroot}%{_tmpfilesdir}/spot.conf

install -d -m 0755 %{buildroot}%{_sysconfdir}/spot
install -m 0640 %{SOURCE4} %{buildroot}%{_sysconfdir}/spot/spot.toml
install -m 0640 %{SOURCE5} %{buildroot}%{_sysconfdir}/spot/environment

install -d -m 0755 %{buildroot}%{_docdir}/spot
install -m 0644 %{SOURCE7} %{buildroot}%{_docdir}/spot/README.install
install -d -m 0755 %{buildroot}%{_licensedir}/spot
install -m 0644 %{SOURCE6} %{buildroot}%{_licensedir}/spot/LICENSE
install -m 0644 %{SOURCE8} %{buildroot}%{_licensedir}/spot/NOTICE

install -d -m 0750 %{buildroot}%{_localstatedir}/lib/spot
install -d -m 0750 %{buildroot}%{_localstatedir}/log/spot

%pre
# Create the system account from the shipped sysusers file. There is no
# scriptlet that starts the service: an administrator does that after setup.
%sysusers_create_compat %{SOURCE1}

%post
%systemd_post spot.service

%preun
%systemd_preun spot.service

%postun
%systemd_postun_with_restart spot.service

%files
%dir %{_sysconfdir}/spot
%config(noreplace) %attr(0640,root,spot) %{_sysconfdir}/spot/spot.toml
%config(noreplace) %attr(0640,root,spot) %{_sysconfdir}/spot/environment
%{_bindir}/spot
%{_unitdir}/spot.service
%{_sysusersdir}/spot.conf
%{_tmpfilesdir}/spot.conf
%doc %{_docdir}/spot/README.install
%license %{_licensedir}/spot/LICENSE
%license %{_licensedir}/spot/NOTICE
%dir %attr(0750,spot,spot) %{_localstatedir}/lib/spot
%dir %attr(0750,spot,spot) %{_localstatedir}/log/spot
%ghost %dir %attr(0750,spot,spot) %{_rundir}/spot

%changelog
@CHANGELOG@
